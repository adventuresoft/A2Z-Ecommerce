{
  "name": "@repo/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mutator": "./src/mutator.ts",
    "./helpers": "./src/helpers.ts",
    "./model": "./src/generated/model/index.ts",
    "./endpoints/*": "./src/generated/endpoints/*"
