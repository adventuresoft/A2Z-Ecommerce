// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SHOP_MANAGER
  CUSTOMER
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role      @default(CUSTOMER)
  isActive        Boolean   @default(true)
  tokenVersion    Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  designation     String?         @db.VarChar(100)
  department      String?         @db.VarChar(100)
  section         String?         @db.VarChar(100)
  location        String?         @db.VarChar(150)
  roleId          String?
  roleDefinition  RoleDefinition? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  stockMovements  StockMovement[]
  orders          Order[]
  orderStatusHistories OrderStatusHistory[]
  shipmentStatusHistories ShipmentStatusHistory[]
  processedRefunds Refund[] @relation("ProcessedRefunds")
  reviews         Review[]
  freelancerReviews FreelancerReview[] @relation("ClientFreelancerReviews")
  reviewReports     FreelancerReviewReport[] @relation("ReporterReviewReports")
  suggestedSkills Skill[]  @relation("SuggestedSkills")
  freelancerProfile FreelancerProfile?
  subscriptions   Subscription[]
  membershipPayments MembershipPayment[]
  contactReveals  ContactReveal[]
  sentConversations Conversation[] @relation("ClientConversations")
  sentMessages    Message[]
  messageReports  MessageReport[]
  blockedUsers    UserBlock[] @relation("BlockerUsers")
  blockedByUsers  UserBlock[] @relation("BlockedUsers")
  notifications   Notification[]
  addresses       UserAddress[]
  auditLogs       AuditLog[]
  couponUsages    CouponUsage[]
  wishlistItems   WishlistItem[]

  @@index([phone])
  @@map("User")
}

model UserAddress {
  id                String   @id @default(uuid())
  userId            String
  label             String?  @db.VarChar(50)
  recipientName     String   @db.VarChar(150)
  phone             String   @db.VarChar(30)
  streetAddress     String   @db.VarChar(255)
  city              String   @db.VarChar(100)
  state             String?  @db.VarChar(100)
  thana             String?  @db.VarChar(100)
  divisionId        Int?     @map("division_id")
  districtId        Int?     @map("district_id")
  thanaId           Int?     @map("thana_id")
  postalCode        String   @db.VarChar(20)
  country           String   @default("Bangladesh") @db.VarChar(100)
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  division          Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  district          District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  thanaRel          Thana?    @relation(fields: [thanaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([divisionId])
  @@index([districtId])
  @@index([thanaId])
  @@map("UserAddress")
}

model RoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@map("RoleDefinition")
}

model PermissionDefinition {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  key         String   @unique @db.VarChar(100)
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module])
  @@index([key])
  @@map("PermissionDefinition")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(120)
  description String?    @db.Text
  imageUrl    String?    @db.VarChar(255)
  parentId    String?
  taxClassId  String?
  isActive            Boolean    @default(true)
  showInBrowseCatalog Boolean    @default(false)
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  taxClass    TaxClass?  @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  products    Product[]
  collections CollectionCategory[]

  @@index([parentId])
  @@index([taxClassId])
  @@index([slug])
  @@index([isActive])
  @@index([showInBrowseCatalog])
  @@map("Category")
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  logoUrl     String?  @db.VarChar(255)
  website     String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([isActive, sortOrder])
  @@map("Brand")
}

enum AttributeType {
  TEXT
  COLOR
  BUTTON
}

model Attribute {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(100)
  slug        String           @unique @db.VarChar(120)
  type        AttributeType    @default(TEXT)
  description String?          @db.Text
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  values      AttributeValue[]

  @@index([isActive, sortOrder])
  @@map("Attribute")
}

model AttributeValue {
  id          String    @id @default(uuid())
  attributeId String
  value       String    @db.VarChar(100)
  label       String?   @db.VarChar(100)
  colorCode   String?   @db.VarChar(20)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attribute   Attribute                      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    ProductVariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
  @@map("AttributeValue")
}

model Product {
  id               String           @id @default(uuid())
  title            String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  description      String           @db.Text
  shortDescription String?          @db.VarChar(500)
  categoryId       String
  brandId          String?
  taxClassId       String?
  thumbnailUrl     String?          @db.VarChar(255)
  warrantyText     String?          @default("Official BTRC / Warranty") @db.VarChar(150)
  specifications   Json?
  isFeatured       Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxClass         TaxClass?        @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  tags             ProductTag[]
  collections      CollectionProduct[]
  reviews          Review[]
  wishlistItems    WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([taxClassId])
  @@index([isActive, isFeatured])
  @@index([slug])
  @@map("Product")
}

model ProductImage {
  id        String           @id @default(uuid())
  productId String
  imageUrl  String           @db.VarChar(255)
  altText   String?          @db.VarChar(200)
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@index([productId, sortOrder])
  @@map("ProductImage")
}

model ProductVariant {
  id           String                        @id @default(uuid())
  productId    String
  sku          String                        @unique @db.VarChar(100)
  barcode      String?                       @db.VarChar(100)
  regularPrice Decimal                       @db.Decimal(10, 2)
  salePrice    Decimal?                      @db.Decimal(10, 2)
  weightGrams  Int?
  imageId      String?
  imageUrl     String?                       @db.VarChar(255)
  isActive     Boolean                       @default(true)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  product        Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  image          ProductImage?                  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  attributes     ProductVariantAttributeValue[]
  inventory      Inventory?
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive])
  @@map("ProductVariant")
}

model ProductVariantAttributeValue {
  variantId        String
  attributeValueId String

  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("ProductVariantAttributeValue")
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @db.VarChar(100)
  slug      String       @unique @db.VarChar(120)
  colorCode String?      @db.VarChar(20)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products  ProductTag[]
  collections CollectionTag[]

  @@index([isActive])
  @@index([slug])
  @@map("Tag")
}

model ProductTag {
  productId String
  tagId     String
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@index([productId])
  @@map("ProductTag")
}

enum StockMovementType {
  INITIAL
  RESTOCK
  PURCHASE_RESERVE
  ORDER_FULFILL
  CANCEL_RESTORE
  RETURN_RESTORE
  MANUAL_ADJUSTMENT
  DAMAGED
}

model Inventory {
  id                String         @id @default(uuid())
  variantId         String         @unique
  quantity          Int            @default(0)
  reservedQuantity  Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt

  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([quantity])
  @@index([lowStockThreshold])
  @@map("Inventory")
}

model StockMovement {
  id                String            @id @default(uuid())
  variantId         String
  type              StockMovementType
  quantityChange    Int
  previousQuantity  Int
  newQuantity       Int
  referenceId       String?           @db.VarChar(100)
  notes             String?           @db.Text
  performedByUserId String?
  createdAt         DateTime          @default(now())

  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  performedByUser   User?             @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([performedByUserId])
  @@map("StockMovement")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  UNFULFILLED
  PREPARING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
}

model Order {
  id                 String               @id @default(uuid())
  orderNumber        String               @unique @db.VarChar(32)
  userId             String
  orderStatus        OrderStatus          @default(PENDING)
  paymentStatus      PaymentStatus        @default(PENDING)
  shipmentStatus     ShipmentStatus       @default(UNFULFILLED)
  subtotal           Decimal              @db.Decimal(10, 2)
  discountAmount     Decimal              @default(0.00) @db.Decimal(10, 2)
  shippingFee        Decimal              @default(0.00) @db.Decimal(10, 2)
  totalTaxAmount     Decimal              @default(0.00) @db.Decimal(10, 2)
  grandTotal         Decimal              @db.Decimal(10, 2)
  recipientName      String               @db.VarChar(150)
  recipientPhone     String               @db.VarChar(30)
  shippingStreet     String               @db.VarChar(255)
  shippingCity       String               @db.VarChar(100)
  shippingState      String?              @db.VarChar(100)
  shippingThana      String?              @db.VarChar(100)
  shippingDivisionId Int?                 @map("shipping_division_id")
  shippingDistrictId Int?                 @map("shipping_district_id")
  shippingThanaId    Int?                 @map("shipping_thana_id")
  shippingPostalCode String               @db.VarChar(20)
  customerNotes      String?              @db.Text
  shippingMethodId   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingMethod     ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  division           Division?            @relation(fields: [shippingDivisionId], references: [id], onDelete: SetNull)
  district           District?            @relation(fields: [shippingDistrictId], references: [id], onDelete: SetNull)
  thana              Thana?               @relation(fields: [shippingThanaId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  shipments          Shipment[]
  payments           Payment[]
  refunds            Refund[]
  reviews            Review[]
  couponUsage        CouponUsage?

  @@index([userId])
  @@index([shippingMethodId])
  @@index([shippingDivisionId])
  @@index([shippingDistrictId])
  @@index([shippingThanaId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([shipmentStatus])
  @@index([createdAt])
  @@map("Order")
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  variantId         String?
  productTitle      String          @db.VarChar(255)
  sku               String          @db.VarChar(100)
  variantAttributes String?         @db.VarChar(255)
  unitPrice         Decimal         @db.Decimal(10, 2)
  quantity          Int
  totalPrice        Decimal         @db.Decimal(10, 2)
  taxRate           Decimal         @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0.00) @db.Decimal(10, 2)
  taxClassName      String?         @db.VarChar(100)

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("OrderItem")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  notes           String?      @db.Text
  changedByUserId String?
  createdAt       DateTime     @default(now())

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([toStatus])
  @@index([changedByUserId])
  @@map("OrderStatusHistory")
}

model ShippingZone {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(100)
  description String?          @db.Text
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  methods     ShippingMethod[]

  @@index([isActive, sortOrder])
  @@map("ShippingZone")
}

model ShippingMethod {
  id            String       @id @default(uuid())
  zoneId        String
  name          String       @db.VarChar(100)
  cost          Decimal      @default(0.00) @db.Decimal(10, 2)
  estimatedDays Int          @default(3)
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  zone          ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  shipments     Shipment[]
  orders        Order[]

  @@index([zoneId, isActive])
  @@map("ShippingMethod")
}

model Shipment {
  id               String                  @id @default(uuid())
  orderId          String
  shippingMethodId String?
  courierName      String                  @db.VarChar(100)
  trackingNumber   String?                 @db.VarChar(100)
  trackingUrl      String?                 @db.VarChar(255)
  status           ShipmentStatus          @default(PREPARING)
  notes            String?                 @db.Text
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingMethod   ShippingMethod?         @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  statusHistory    ShipmentStatusHistory[]

  @@index([orderId])
  @@index([shippingMethodId])
  @@index([trackingNumber])
  @@index([status])
  @@map("Shipment")
}

model ShipmentStatusHistory {
  id              String         @id @default(uuid())
  shipmentId      String
  fromStatus      ShipmentStatus?
  toStatus        ShipmentStatus
  notes           String?        @db.Text
  changedByUserId String?
  createdAt       DateTime       @default(now())

  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  changedByUser   User?          @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([toStatus])
  @@index([changedByUserId])
  @@map("ShipmentStatusHistory")
}

model StoreSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  dataType    String   @default("STRING") @db.VarChar(30)
  group       String   @default("GENERAL") @db.VarChar(50)
  isPublic    Boolean  @default(false)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@index([isPublic])
  @@map("StoreSetting")
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CHECK_PAYMENT
  BANK_TRANSFER
  CREDIT_CARD
  MOBILE_BANKING
  PAYSTATION
}

model PaymentMethodSetting {
  id           String   @id @default(uuid())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  instructions String?  @db.Text
  isEnabled    Boolean  @default(true)
  sortOrder    Int      @default(0)
  merchantId   String?  @db.VarChar(100)
  password     String?  @db.VarChar(255)
  isSandbox    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isEnabled, sortOrder])
  @@map("PaymentMethodSetting")
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  method         PaymentMethod @default(CASH_ON_DELIVERY)
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("BDT") @db.VarChar(10)
  transactionRef String?       @db.VarChar(100)
  idempotencyKey String?       @unique @db.VarChar(100)
  notes          String?       @db.Text
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds        Refund[]

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([transactionRef])
  @@index([createdAt])
  @@map("Payment")
}

model Refund {
  id                String        @id @default(uuid())
  orderId           String
  paymentId         String
  amount            Decimal       @db.Decimal(10, 2)
  reason            String        @db.Text
  status            RefundStatus  @default(COMPLETED)
  refundMethod      PaymentMethod?
  transactionRef    String?       @db.VarChar(100)
  notes             String?       @db.Text
  processedByUserId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  processedByUser   User?         @relation("ProcessedRefunds", fields: [processedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([processedByUserId])
  @@index([createdAt])
  @@map("Refund")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  LOW_STOCK
  PROMOTION
  SYSTEM
  MESSAGE_NEW
  FREELANCER_APPROVED
  FREELANCER_REJECTED
  REVISION_RESULT
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  REPORT_UPDATE
}

model Review {
  id                 String       @id @default(uuid())
  productId          String
  userId             String
  orderId            String?
  rating             Int
  title              String?      @db.VarChar(150)
  comment            String       @db.Text
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  order              Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
  @@map("Review")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  linkUrl   String?          @db.VarChar(255)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("Notification")
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  action      String    @db.VarChar(100)
  entityType  String    @db.VarChar(100)
  entityId    String    @db.VarChar(100)
  oldValues   Json?
  newValues   Json?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("AuditLog")
}

model TaxClass {
  id          String     @id @default(uuid())
  name        String     @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  rate        Decimal    @db.Decimal(5, 2)
  isDefault   Boolean    @default(false)
  isActive    Boolean    @default(true)
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categories  Category[]
  products    Product[]

  @@index([isActive, isDefault])
  @@index([code])
  @@map("TaxClass")
}

// ============================================================================
// COUPON & PROMOTIONS MODELS
// ============================================================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id                String        @id @default(uuid())
  code              String        @unique @db.VarChar(50)
  description       String?       @db.VarChar(255)
  discountType      DiscountType  @default(FIXED_AMOUNT)
  discountValue     Decimal       @db.Decimal(10, 2)
  minOrderAmount    Decimal?      @db.Decimal(10, 2)
  maxDiscountAmount Decimal?      @db.Decimal(10, 2)
  totalUsageLimit   Int?
  perCustomerLimit  Int           @default(1)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  usages            CouponUsage[]

  @@index([code, isActive])
  @@index([startDate, endDate])
  @@map("Coupon")
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  orderId         String   @unique
  userId          String
  discountApplied Decimal  @db.Decimal(10, 2)
  usedAt          DateTime @default(now())

  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@index([userId])
  @@map("CouponUsage")
}

// ============================================================================
// WISHLIST MODEL
// ============================================================================

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("WishlistItem")
}

// ============================================================================
// COLLECTION MODELS
// ============================================================================

model Collection {
  id             String               @id @default(uuid())
  name           String               @db.VarChar(150)
  slug           String               @unique @db.VarChar(150)
  description    String?              @db.Text
  bannerUrl      String?              @db.VarChar(255)
  badgeText      String?              @db.VarChar(50)
  showOnHomePage Boolean              @default(false)
  designTemplate String               @default("default") @db.VarChar(50)
  isActive       Boolean              @default(true)
  startDate      DateTime?
  endDate        DateTime?
  seoTitle       String?              @db.VarChar(150)
  seoDescription String?              @db.VarChar(255)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  categories     CollectionCategory[]
  tags           CollectionTag[]
  products       CollectionProduct[]

  @@index([slug])
  @@index([isActive])
  @@index([isActive, showOnHomePage, sortOrder])
  @@map("Collection")
}

model CollectionCategory {
  collectionId String
  categoryId   String
  createdAt    DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([collectionId, categoryId])
  @@index([categoryId])
  @@index([collectionId])
  @@map("CollectionCategory")
}

model CollectionTag {
  collectionId String
  tagId        String
  createdAt    DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([collectionId, tagId])
  @@index([tagId])
  @@index([collectionId])
  @@map("CollectionTag")
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  isPinned     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId])
  @@map("CollectionProduct")
}

model OtpCode {
  id         String   @id @default(uuid())
  phone      String   @db.VarChar(30)
  codeHash   String   @db.VarChar(255)
  purpose    String   @default("SIGNUP") @db.VarChar(50)
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([phone])
  @@map("OtpCode")
}


// -----------------------------------------------------------------------------
// Location Models (Bangladesh Divisions, Districts, Thanas, Unions, etc.)
// -----------------------------------------------------------------------------

model Division {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(255)
  bnName    String     @unique @map("bn_name") @db.VarChar(255)
  status    Boolean    @default(true)
  createdAt DateTime?  @default(now()) @map("created_at")
  updatedAt DateTime?  @updatedAt @map("updated_at")

  districts     District[]
  userAddresses UserAddress[]
  orders        Order[]
  freelancerLocations FreelancerLocation[]

  @@map("divisions")
}

model District {
  id               Int               @id @default(autoincrement())
  divisionId       Int               @map("division_id")
  name             String            @db.VarChar(255)
  bnName           String?           @map("bn_name") @db.VarChar(255)
  status           Boolean           @default(true)
  createdAt        DateTime?         @default(now()) @map("created_at")
  updatedAt        DateTime?         @updatedAt @map("updated_at")

  division         Division          @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  thanas           Thana[]
  cityCorporations CityCorporation[]
  paurashavas      Paurashava[]
  userAddresses    UserAddress[]
  orders           Order[]
  freelancerLocations FreelancerLocation[]

  @@index([divisionId])
  @@map("districts")
}

model CityCorporation {
  id         Int       @id @default(autoincrement())
  districtId Int       @map("district_id")
  name       String    @db.VarChar(255)
  bnName     String?   @map("bn_name") @db.VarChar(255)
  status     Boolean   @default(true)
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  wards      Ward[]
  freelancerLocations FreelancerLocation[]

  @@index([districtId])
  @@map("city_corporations")
}

model Thana {
  id         Int       @id @default(autoincrement())
  districtId Int       @map("district_id")
  name       String    @db.VarChar(255)
  bnName     String?   @map("bn_name") @db.VarChar(255)
  status     Boolean   @default(true)
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  unions        Union[]
  postOffices   PostOffice[]
  userAddresses UserAddress[]
  orders        Order[]
  freelancerLocations FreelancerLocation[]

  @@index([districtId])
  @@map("thanas")
}

model Union {
  id        Int       @id @default(autoincrement())
  thanaId   Int       @map("thana_id")
  name      String    @db.VarChar(255)
  bnName    String?   @map("bn_name") @db.VarChar(255)
  status    Boolean   @default(true)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  thana     Thana     @relation(fields: [thanaId], references: [id], onDelete: Cascade)
  freelancerLocations FreelancerLocation[]

  @@index([thanaId])
  @@map("unions")
}

model PostOffice {
  id         Int       @id @default(autoincrement())
  thanaId    Int       @map("thana_id")
  name       String?   @db.VarChar(255)
  bnName     String?   @map("bn_name") @db.VarChar(255)
  postalCode String?   @map("postal_code") @db.VarChar(50)
  status     Boolean   @default(true)
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  thana      Thana     @relation(fields: [thanaId], references: [id], onDelete: Cascade)
  freelancerLocations FreelancerLocation[]

  @@index([thanaId])
  @@index([postalCode])
  @@map("post_offices")
}

model Paurashava {
  id         Int       @id @default(autoincrement())
  districtId Int       @map("district_id")
  name       String    @db.VarChar(255)
  bnName     String?   @map("bn_name") @db.VarChar(255)
  status     Boolean   @default(true)
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  freelancerLocations FreelancerLocation[]

  @@index([districtId])
  @@map("paurashavas")
}

model Ward {
  id                Int             @id @default(autoincrement())
  cityCorporationId Int             @map("city_corporation_id")
  wardNo            Int             @map("ward_no")
  name              String?         @db.VarChar(255)
  bnName            String?         @map("bn_name") @db.VarChar(255)
  createdAt         DateTime?       @default(now()) @map("created_at")
  updatedAt         DateTime?       @updatedAt @map("updated_at")

  cityCorporation   CityCorporation @relation(fields: [cityCorporationId], references: [id], onDelete: Cascade)
  freelancerLocations FreelancerLocation[]

  @@unique([cityCorporationId, wardNo])
  @@index([cityCorporationId])
  @@map("wards")
}

// -----------------------------------------------------------------------------
// Freelancer Marketplace Taxonomy Models
// -----------------------------------------------------------------------------

enum SkillStatus {
  ACTIVE
  PENDING
  REJECTED
}

model ProfessionCategory {
  id          String       @id @default(uuid())
  name        String       @db.VarChar(100)
  bnName      String?      @map("bn_name") @db.VarChar(150)
  icon        String?      @db.VarChar(50)
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  professions Profession[]

  @@map("profession_categories")
}

model Profession {
  id          String             @id @default(uuid())
  categoryId  String             @map("category_id")
  name        String             @db.VarChar(100)
  bnName      String?            @map("bn_name") @db.VarChar(150)
  isActive    Boolean            @default(true) @map("is_active")
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  category    ProfessionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skills      Skill[]
  freelancerProfiles FreelancerProfile[]

  @@index([categoryId])
  @@map("professions")
}

model Skill {
  id            String       @id @default(uuid())
  professionId  String       @map("profession_id")
  name          String       @db.VarChar(100)
  bnName        String?      @map("bn_name") @db.VarChar(150)
  status        SkillStatus  @default(ACTIVE)
  suggestedById String?      @map("suggested_by_id")
  mergedIntoId  String?      @map("merged_into_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  profession    Profession   @relation(fields: [professionId], references: [id], onDelete: Cascade)
  suggestedBy   User?        @relation("SuggestedSkills", fields: [suggestedById], references: [id], onDelete: SetNull)
  mergedInto    Skill?       @relation("SkillMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedSkills  Skill[]      @relation("SkillMerges")
  freelancerSkills FreelancerSkill[]

  @@unique([professionId, name])
  @@index([professionId, status])
  @@index([suggestedById])
  @@map("skills")
}

// -----------------------------------------------------------------------------
// Freelancer Marketplace Core Models
// -----------------------------------------------------------------------------

enum FreelancerStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum FreelancerAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ServicePriceType {
  FIXED
  HOURLY
  DAILY
  NEGOTIABLE
}

enum RevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

model FreelancerProfile {
  id              String                 @id @default(uuid())
  userId          String                 @unique @map("user_id")
  status          FreelancerStatus       @default(DRAFT)
  displayName     String                 @map("display_name") @db.VarChar(150)
  nidNumber       String?                @map("nid_number") @db.VarChar(30)
  photoUrl        String?                @map("photo_url") @db.VarChar(500)
  professionId    String?                @map("profession_id")
  title           String?                @db.VarChar(150)
  about           String?                @db.Text
  experienceYears Int                    @default(0) @map("experience_years")
  email           String?                @db.VarChar(150)
  address         String?                @db.VarChar(255)
  availability    FreelancerAvailability @default(AVAILABLE)
  startingPrice   Int?                   @map("starting_price")
  averageRating   Decimal?               @map("average_rating") @db.Decimal(3, 2)
  totalReviews    Int                    @default(0) @map("total_reviews")
  rejectionReason String?                @map("rejection_reason") @db.Text
  rejectionCount  Int                    @default(0) @map("rejection_count")
  approvedAt      DateTime?              @map("approved_at")
  approvedById    String?                @map("approved_by_id")
  suspendedAt     DateTime?              @map("suspended_at")
  suspendReason   String?                @map("suspend_reason") @db.Text
  featuredUntil   DateTime?              @map("featured_until")
  lastActiveAt    DateTime?              @map("last_active_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession      Profession?            @relation(fields: [professionId], references: [id], onDelete: SetNull)
  locations       FreelancerLocation[]
  services        FreelancerService[]
  skills          FreelancerSkill[]
  portfolio       PortfolioItem[]
  revisions       ProfileRevision[]
  contactReveals  ContactReveal[]
  conversations   Conversation[] @relation("FreelancerConversations")
  reviews         FreelancerReview[]

  @@index([status, professionId])
  @@index([status, availability])
  @@index([startingPrice])
  @@index([averageRating])
  @@index([experienceYears])
  @@index([nidNumber])
  @@map("freelancer_profiles")
}

model FreelancerLocation {
  id                String             @id @default(uuid())
  freelancerId      String             @map("freelancer_id")
  divisionId        Int                @map("division_id")
  districtId        Int                @map("district_id")
  thanaId           Int                @map("thana_id")
  postOfficeId      Int                @map("post_office_id")
  cityCorporationId Int?               @map("city_corporation_id")
  wardId            Int?               @map("ward_id")
  paurashavaId      Int?               @map("paurashava_id")
  unionId           Int?               @map("union_id")
  localityText      String?            @map("locality_text") @db.VarChar(100)
  isPrimary         Boolean            @default(false) @map("is_primary")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  freelancer        FreelancerProfile  @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  division          Division           @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  district          District           @relation(fields: [districtId], references: [id], onDelete: Restrict)
  thana             Thana              @relation(fields: [thanaId], references: [id], onDelete: Restrict)
  postOffice        PostOffice         @relation(fields: [postOfficeId], references: [id], onDelete: Restrict)
  cityCorporation   CityCorporation?   @relation(fields: [cityCorporationId], references: [id], onDelete: SetNull)
  ward              Ward?              @relation(fields: [wardId], references: [id], onDelete: SetNull)
  paurashava        Paurashava?        @relation(fields: [paurashavaId], references: [id], onDelete: SetNull)
  union             Union?             @relation(fields: [unionId], references: [id], onDelete: SetNull)

  @@index([freelancerId])
  @@index([divisionId])
  @@index([districtId])
  @@index([thanaId])
  @@index([postOfficeId])
  @@map("freelancer_locations")
}

model FreelancerService {
  id           String            @id @default(uuid())
  freelancerId String            @map("freelancer_id")
  title        String            @db.VarChar(150)
  description  String?           @db.Text
  priceType    ServicePriceType  @default(FIXED) @map("price_type")
  amount       Int?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId])
  @@map("freelancer_services")
}

model FreelancerSkill {
  freelancerId String            @map("freelancer_id")
  skillId      String            @map("skill_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill        Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerId, skillId])
  @@index([skillId])
  @@map("freelancer_skills")
}

model PortfolioItem {
  id           String            @id @default(uuid())
  freelancerId String            @map("freelancer_id")
  imageUrl     String            @map("image_url") @db.VarChar(500)
  caption      String?           @db.VarChar(200)
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at")

  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId])
  @@map("portfolio_items")
}

model ProfileRevision {
  id           String            @id @default(uuid())
  freelancerId String            @map("freelancer_id")
  payload      Json
  status       RevisionStatus    @default(PENDING)
  reviewedById String?           @map("reviewed_by_id")
  reason       String?           @db.Text
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId, status])
  @@map("profile_revisions")
}

enum MembershipPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model MembershipPlan {
  id           String              @id @default(uuid())
  name         String              @db.VarChar(100)
  durationDays Int                 @map("duration_days")
  price        Int
  features     Json?
  isActive     Boolean             @default(true) @map("is_active")
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  subscriptions Subscription[]
  payments      MembershipPayment[]

  @@map("membership_plans")
}

model MembershipPayment {
  id             String                  @id @default(uuid())
  userId         String                  @map("user_id")
  planId         String                  @map("plan_id")
  amount         Int
  gateway        String                  @default("PAYSTATION")
  gatewayTxnId   String?                 @unique @map("gateway_txn_id")
  idempotencyKey String                  @unique @map("idempotency_key")
  status         MembershipPaymentStatus @default(PENDING)
  rawPayload     Json?                   @map("raw_payload")
  paidAt         DateTime?               @map("paid_at")
  refundedById   String?                 @map("refunded_by_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription?

  @@index([userId, status])
  @@map("membership_payments")
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  planId          String             @map("plan_id")
  paymentId       String             @unique @map("payment_id")
  startsAt        DateTime           @map("starts_at")
  expiresAt       DateTime           @map("expires_at")
  status          SubscriptionStatus @default(ACTIVE)
  cancelledReason String?            @map("cancelled_reason") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    MembershipPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment MembershipPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, status])
  @@map("subscriptions")
}

model ContactReveal {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  freelancerId String            @map("freelancer_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([freelancerId, createdAt])
  @@map("contact_reveals")
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageFlag {
  PHONE
  LINK
}

model Conversation {
  id               String             @id @default(uuid())
  clientId         String             @map("client_id")
  freelancerId     String             @map("freelancer_id")
  lastMessageAt    DateTime?          @map("last_message_at")
  clientUnread     Int                @default(0) @map("client_unread")
  freelancerUnread Int                @default(0) @map("freelancer_unread")
  status           ConversationStatus @default(OPEN)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  client     User              @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation("FreelancerConversations", fields: [freelancerId], references: [id], onDelete: Cascade)
  messages   Message[]
  reports    MessageReport[]

  @@unique([clientId, freelancerId])
  @@index([clientId])
  @@index([freelancerId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  senderId       String        @map("sender_id")
  body           String        @db.Text
  flags          MessageFlag[] @default([])
  readAt         DateTime?     @map("read_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports      MessageReport[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReport {
  id             String    @id @default(uuid())
  messageId      String?   @map("message_id")
  conversationId String    @map("conversation_id")
  reporterId     String    @map("reporter_id")
  reason         String    @db.Text
  status         String    @default("PENDING") @db.VarChar(50)
  reviewedById   String?   @map("reviewed_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporter     User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("message_reports")
}

model UserBlock {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model FilterTerm {
  id        String   @id @default(uuid())
  term      String   @unique @db.VarChar(100)
  language  String   @default("bn") @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("filter_terms")
}

enum FreelancerReviewStatus {
  APPROVED
  PENDING
  HIDDEN
}

enum ReviewReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model FreelancerReview {
  id                String                 @id @default(uuid())
  freelancerId      String                 @map("freelancer_id")
  clientId          String                 @map("client_id")
  rating            Int
  comment           String                 @db.Text
  images            String[]               @default([])
  freelancerReply   String?                @map("freelancer_reply") @db.Text
  repliedAt         DateTime?              @map("replied_at")
  isVerifiedContact Boolean                @default(true) @map("is_verified_contact")
  editCount         Int                    @default(0) @map("edit_count")
  status            FreelancerReviewStatus @default(APPROVED)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  freelancer        FreelancerProfile      @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  client            User                   @relation("ClientFreelancerReviews", fields: [clientId], references: [id], onDelete: Cascade)
  reports           FreelancerReviewReport[]

  @@unique([freelancerId, clientId])
  @@index([freelancerId, status])
  @@index([clientId])
  @@map("freelancer_reviews")
}

model FreelancerReviewReport {
  id           String             @id @default(uuid())
  reviewId     String             @map("review_id")
  reporterId   String             @map("reporter_id")
  reason       String             @db.Text
  status       ReviewReportStatus @default(PENDING)
  reviewedById String?            @map("reviewed_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  review       FreelancerReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter     User               @relation("ReporterReviewReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@index([reporterId])
  @@map("freelancer_review_reports")
}


